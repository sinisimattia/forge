# Database (local development only — compose.yaml carries the matching dev credentials)
#
# Two roles, not one. POSTGRES_USER owns the schema and runs the migrations;
# APP_DB_ROLE owns nothing and is what the API connects as. The first migration
# creates the second role from APP_DB_ROLE/APP_DB_PASSWORD and fails loudly if
# either is missing — there is no default, because a default would be a
# credential every project generated from this template shipped with.
#
# The separation is what makes the audit log append-only: UPDATE and DELETE on
# audit_entries are revoked from APP_DB_ROLE, and a non-owner cannot grant them
# back to itself. Point both URLs at the same role and everything still works,
# minus that guarantee.
POSTGRES_DB=__FORGE_DB_NAME__
POSTGRES_USER=__FORGE_NAME__
APP_DB_ROLE=__FORGE_NAME__-app
APP_DB_PASSWORD=__FORGE_NAME__-app

# The API's connection — the restricted role.
DATABASE_URL=postgresql://__FORGE_NAME__-app:__FORGE_NAME__-app@postgres:5432/__FORGE_DB_NAME__
# The TypeORM CLI's connection — the owner. Falls back to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=postgresql://__FORGE_NAME__:__FORGE_NAME__@postgres:5432/__FORGE_DB_NAME__

# Backend
NODE_ENV=development
PORT=3000

# Mail (ADR-0008: no provider account, no key — messages are written to disk)
#
# The origin every mail link is built from. Deliberately a deployment-configured
# value and NEVER read off an incoming request — see
# apps/backend/src/mail/templates/reset-password.ts for why a link built from a
# request's Host header is a host-header-injection hazard.
PUBLIC_WEBAPP_URL=http://localhost:3001
# Where FileMailer writes one JSON file per message. Relative to the backend's own
# working directory; see .gitignore — a generated project must never commit its own
# outbox, which would commit live verification and reset links.
MAIL_OUTBOX_DIR=./.mail-outbox

# The key access credentials are signed with.
#
# This value is for local development only, and compose.yaml pins its own copy of it
# (environment: wins over env_file:), so the dev stack works whether or not this file
# has been copied to .env. compose.prod.yaml has NO default for it — a production stack
# refuses to start until one is supplied, because a fallback signing key is one every
# project generated from this template would share, and whoever holds it can mint an
# access credential for any account on any of them.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=__FORGE_NAME__-local-dev-signing-key-not-for-production

# Webapp
NUXT_PUBLIC_API_BASE=http://localhost:3000

# Host-published ports. Uncomment to change what the stack binds on your machine;
# compose falls back to these same defaults when they are unset.
# POSTGRES_PORT=5432
# BACKEND_PORT=3000
# BACKEND_DEBUG_PORT=9229
# WEBAPP_PORT=3001

# Federated sign-in (Google, GitHub, a generic OIDC provider) — ADR-0008: ports, not
# vendors.
#
# An absent variable means an absent provider, not an error: buildOAuthProviders
# (apps/backend/src/auth/oauth/oauth.config.ts) builds an adapter only when every
# variable it needs is present and non-empty, and silently skips anything left
# unset — half a provider's credentials is treated the same as none.
#
# The origin this deployment sends a provider's callback to. Required the moment any
# provider below is configured, and must match whatever redirect URI is registered at
# that provider's own developer console. Deployment-configured and NEVER read off an
# incoming request's Host header — see apps/backend/src/mail/templates/reset-password.ts
# for the same hazard this would otherwise reproduce: a redirect URI built from a
# request header lets anyone who can reach this API choose where an authorization code
# is delivered.
PUBLIC_API_URL=http://localhost:3000

# Google. Both variables must be set for Google to register.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub. Both variables must be set for GitHub to register.
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# A generic OpenID Connect provider, for anything that is neither Google nor GitHub.
# All three variables must be set for it to register.
# OAUTH_OIDC_CLIENT_ID=
# OAUTH_OIDC_CLIENT_SECRET=
# OAUTH_OIDC_ISSUER_URL=

# The development provider — an adapter that authenticates nobody, on purpose. It
# exists so a freshly generated project can exercise the federated sign-in flow with no
# developer application registered anywhere. It registers under AuthProvider.OIDC, the
# same name a real generic OIDC provider above would use, so the application refuses to
# start if both are set: the two would silently compete for one name, and which one
# answered a sign-in would depend on the order lines happen to run in. The application
# also refuses to start if this is set with NODE_ENV=production — unset it for that
# environment; changing NODE_ENV is not the fix.
# OAUTH_DEV_ENABLED=1
