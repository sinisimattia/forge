{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/core/src",
  "targets": {
    "build":     { "executor": "nx:run-commands", "options": { "command": "npm run build",     "cwd": "libs/core" } },
    "test":      { "executor": "nx:run-commands", "options": { "command": "npm run test",      "cwd": "libs/core" } },
    "lint":      { "executor": "nx:run-commands", "options": { "command": "npm run lint",      "cwd": "libs/core" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "npm run typecheck", "cwd": "libs/core" } },
    "purity":    { "executor": "nx:run-commands", "options": { "command": "npm run purity",    "cwd": "libs/core" } }
  }
}
