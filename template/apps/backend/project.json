{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend/src",
  "targets": {
    "build":     { "executor": "nx:run-commands", "options": { "command": "npm run build",     "cwd": "apps/backend" } },
    "test":      { "executor": "nx:run-commands", "options": { "command": "npm run test",      "cwd": "apps/backend" } },
    "lint":      { "executor": "nx:run-commands", "options": { "command": "npm run lint",      "cwd": "apps/backend" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "npm run typecheck", "cwd": "apps/backend" } },
    "serve":     { "executor": "nx:run-commands", "options": { "command": "npm run start:dev", "cwd": "apps/backend" } }
  }
}
